{
 "format": "walkdown-plant-procedure",
 "version": 1,
 "id": "crane_lift",
 "title": "Lift a crate of spares onto the operating floor",
 "kind": "procedure",
 "scenario": "cold_iron",
 "intro": [
  {"p": ["Lift a crate of spares from the turbine hall's laydown bay onto the operating floor with the hall's crane (", {"link": ["30SMT10"], "to": {"kks": "30SMT10"}}, "), worked from its pendant or its radio remote: hook on, hoist, travel, set down and unhook."]}
 ],
 "steps": [
  {"id": "travel_east", "text": ["At the crane's pendant (", {"link": ["30SMT10"], "to": {"kks": "30SMT10"}}, "), hold East: run the bridge (", {"link": ["30SMT10AE003"], "to": {"kks": "30SMT10AE003"}}, ") to the laydown bay at the hall's east end."], "at": ["30SMT10"], "go": "walk", "do": [{"kks": "30SMT10AE003", "do": "set", "value": 1}], "ordered": true, "done": "crane_at_laydown", "why": [{"p": ["The laydown bay is the ground floor's strip along the south wall: nothing stands over it, so a load comes up from there past the operating floor's edge."]}]},
  {"id": "trolley_south", "text": ["Release East, then hold South until the trolley (", {"link": ["30SMT10AE002"], "to": {"kks": "30SMT10AE002"}}, ") stops over the crate."], "at": ["30SMT10"], "go": "walk", "do": [{"kks": "30SMT10AE003", "do": "set", "value": 0}, {"kks": "30SMT10AE002", "do": "set", "value": -1}], "ordered": true, "done": "crane_south"},
  {"id": "lower", "text": ["Release South, then hold Down: lower the hook (", {"link": ["30SMT10AE001"], "to": {"kks": "30SMT10AE001"}}, ") to the crate's sling."], "at": ["30SMT10"], "go": "walk", "do": [{"kks": "30SMT10AE002", "do": "set", "value": 0}, {"kks": "30SMT10AE001", "do": "set", "value": -1}], "ordered": true, "done": "crane_at_load"},
  {"id": "hook_on", "text": ["Release Down and close the hook's latch (", {"link": ["30SMT10AE004"], "to": {"kks": "30SMT10AE004"}}, ") on the sling."], "at": ["30SMT10AE004"], "go": "walk", "do": [{"kks": "30SMT10AE001", "do": "set", "value": 0}, {"kks": "30SMT10AE004", "do": "close"}], "ordered": true, "done": "crane_latch"},
  {"id": "hoist", "text": ["Hold Up: hoist the crate until it clears the operating floor's handrail. The load cell (", {"link": ["30SMT10CW001"], "to": {"kks": "30SMT10CW001"}}, ") shows its weight."], "at": ["30SMT10", "30SMT10CW001"], "go": "walk", "do": [{"kks": "30SMT10AE001", "do": "set", "value": 1}], "ordered": true, "done": "crane_clear", "why": [{"p": ["The crane is rated 63 t; the bridge and the trolley move a hooked load only once it is clear of the floor's edge."]}]},
  {"id": "trolley_north", "text": ["Release Up, then hold North: bring the crate in over the operating floor."], "at": ["30SMT10"], "go": "walk", "do": [{"kks": "30SMT10AE001", "do": "set", "value": 0}, {"kks": "30SMT10AE002", "do": "set", "value": 1}], "ordered": true, "done": "crane_north"},
  {"id": "travel_west", "text": ["Release North, then hold West: travel the bridge to the set-down place, clear of the turbine."], "at": ["30SMT10"], "go": "walk", "do": [{"kks": "30SMT10AE002", "do": "set", "value": 0}, {"kks": "30SMT10AE003", "do": "set", "value": -1}], "ordered": true, "done": "crane_west"},
  {"id": "lower_floor", "text": ["Release West, then hold Down: set the crate down on the operating floor."], "at": ["30SMT10"], "go": "walk", "do": [{"kks": "30SMT10AE003", "do": "set", "value": 0}, {"kks": "30SMT10AE001", "do": "set", "value": -1}], "ordered": true, "done": "crane_rest"},
  {"id": "unhook", "text": ["Release Down and open the hook's latch (", {"link": ["30SMT10AE004"], "to": {"kks": "30SMT10AE004"}}, ")."], "at": ["30SMT10AE004"], "go": "walk", "do": [{"kks": "30SMT10AE001", "do": "set", "value": 0}, {"kks": "30SMT10AE004", "do": "open"}], "ordered": true, "done": "crane_free"},
  {"id": "clear", "text": ["Hold Up to raise the empty hook clear, then release."], "at": ["30SMT10"], "go": "walk", "do": [{"kks": "30SMT10AE001", "do": "set", "value": 1}], "ordered": true, "done": "crane_hook_clear"}
 ]
}
