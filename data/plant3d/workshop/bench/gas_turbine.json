 "ops": [
  {"at": "bench", "do": "start", "title": "Excitation on", "set": {"exc_cmd": 1}, "needs": [["spd95", "GT 1 below 95 % speed: excitation would overflux the generator"]]},
  {"at": "bench", "do": "stop", "title": "Excitation off", "set": {"exc_cmd": 0}, "needs": [["brk_open", "The generator breaker is closed: open it first"]]},
  {"at": "bench", "do": "close_breaker", "title": "Close the breaker", "set": {"brk_cmd": 1}, "needs": [["in_fsnl", "GT 1 not at full speed no load"], ["exc_cmd", "Excitation off"], ["ph_ok", "Sync check: phase angle outside ±10°"], ["slip_ok", "Sync check: frequency difference over 0.1 Hz"], ["v_ok", "Sync check: voltage difference over 5 %"]]},
  {"at": "bench", "do": "open_breaker", "title": "Open the breaker", "set": {"brk_cmd": 0}},
  {"at": "brg1_housing", "do": "set", "title": "Speed bias", "input": "bias", "range": [-0.01, 0.01]},
  {"at": "rotor", "do": "start", "title": "Start", "machine": "turbine", "needs": [["lube_ok", "Lube oil pressure below 1.8 bar"], ["tg_run", "Turning gear not running"], ["gas_ok", "Fuel gas pressure below 25 bar"], ["ccw_ok", "Closed cooling water not in service"], ["trips_clear", "A GT trip is latched: reset it first"], ["hp_lvl_ok", "HP drum level outside ±150 mm"], ["fw_avail", "No feedwater pump running"], ["wash_idle", "A compressor wash is running"]]},
  {"at": "rotor", "do": "stop", "title": "Stop", "machine": "turbine"},
  {"at": "bench", "do": "set", "title": "Load set point", "input": "load_sp", "range": [10, 250]},
  {"at": "brg1_housing", "do": "start", "title": "Turning gear on", "set": {"tg_cmd": 1}, "needs": [["lube_ok", "Lube oil pressure below 1.8 bar"]]},
  {"at": "brg1_housing", "do": "stop", "title": "Turning gear off", "set": {"tg_cmd": 0}},
  {"at": "brg1_housing", "do": "reset", "title": "Reset: lube oil", "trip": "trip_lube"},
  {"at": "liner_02", "do": "reset", "title": "Reset: flame", "trip": "trip_flame"},
  {"at": "exhaust", "do": "reset", "title": "Reset: exhaust temperature", "trip": "trip_exh"},
  {"at": "exhaust", "do": "reset", "title": "Reset: exhaust spread", "trip": "trip_spread"},
  {"at": "brg1_housing", "do": "reset", "title": "Reset: overspeed", "trip": "trip_os"},
  {"at": "brg1_upper", "do": "reset", "title": "Reset: vibration", "trip": "trip_vib"},
  {"at": "rotor", "do": "reset", "title": "Reset: surge", "trip": "trip_surge"},
  {"at": "brg1_housing", "do": "reset", "title": "Reset: oil temperature", "trip": "trip_oil_temp"},
  {"at": "bench", "do": "reset", "title": "Reset: breaker", "trip": "trip_breaker"},
  {"at": "intake", "do": "set", "input": "ambient_t", "range": [0, 50], "title": "Ambient temperature"}
 ],
 "interlocks": [
  {"id": "dc_auto", "when": "dc_auto_c", "do": [{"set": {"ldc_cmd": 1}}], "at": "bench", "text": "Lube oil pressure low while the oil system is in service: the DC emergency pump starts"}
 ],
 "machines": [
  {"id": "turbine", "at": "rotor", "init": "standstill", "commands": {"start": {"from": ["standstill"], "to": "crank"}, "stop": {"from": ["crank", "purge", "coast", "ignite", "accel", "accel_sfc_off", "fsnl"], "to": "coastdown"}}, "states": [{"id": "standstill", "set": {"sfc_on": 0, "fuel_on": 0, "ign": 0, "speed_sp": 0, "bias": 0}, "watch": false}, {"id": "crank", "set": {"sfc_on": 1, "speed_sp": 0.25}, "next": [["at_crank", "purge"]], "say": "Cranking: the static frequency converter drives the generator as a motor"}, {"id": "purge", "next": [["purge_done", "coast"]], "watch": false, "say": "HRSG purge: five volume changes of air through the gas path"}, {"id": "coast", "set": {"sfc_on": 0, "speed_sp": 0.15}, "next": [["at_coast", "ignite"]], "say": "Coasting down to ignition speed"}, {"id": "ignite", "set": {"sfc_on": 1, "ign": 1, "fuel_on": 1}, "next": [["flame", "accel"]], "say": "Ignition: fuel gas and igniters on"}, {"id": "accel", "set": {"ign": 0, "speed_sp": 1}, "next": [["at_sfc_off", "accel_sfc_off"]], "say": "Flame detected: accelerating with the SFC"}, {"id": "accel_sfc_off", "set": {"sfc_on": 0}, "next": [["at_full", "fsnl"]], "say": "SFC off at 70 % speed: the turbine accelerates on its own"}, {"id": "fsnl", "next": [["brk_cmd", "loaded"]], "watch": false, "say": "Full speed no load: ready to synchronise"}, {"id": "loaded", "next": [["brk_open", "fsnl"]], "watch": false, "say": "On the grid"}, {"id": "coastdown", "set": {"sfc_on": 0, "fuel_on": 0, "ign": 0, "speed_sp": 0, "bias": 0}, "next": [["still", "standstill"]], "say": "Stopping: fuel off"}, {"id": "trip", "set": {"sfc_on": 0, "fuel_on": 0, "ign": 0, "speed_sp": 0, "bias": 0}, "next": [["still", "standstill"]], "say": "TRIPPED: fuel off"}]}
 ],
 "trips": [
  {"id": "trip_lube", "at": "brg1_housing", "text": "GT 1 lube oil pressure low-low", "when": "lp_ll", "do": [{"machine": "turbine", "to": "trip"}], "isa": "PALL", "delay": 1, "first_out": "gt1"},
  {"id": "trip_flame", "at": "liner_02", "text": "GT 1 flame failure", "when": "flame_lost", "do": [{"machine": "turbine", "to": "trip"}], "isa": "BAL", "delay": 1, "first_out": "gt1"},
  {"id": "trip_exh", "at": "exhaust", "text": "GT 1 exhaust temperature high-high", "when": "exh_hh", "do": [{"machine": "turbine", "to": "trip"}], "isa": "TAHH", "delay": 1, "first_out": "gt1"},
  {"id": "trip_spread", "at": "exhaust", "text": "GT 1 exhaust temperature spread high-high", "when": "spread_hh", "do": [{"machine": "turbine", "to": "trip"}], "isa": "TDAHH", "delay": 3, "first_out": "gt1"},
  {"id": "trip_os", "at": "brg1_housing", "text": "GT 1 overspeed", "when": "os", "do": [{"machine": "turbine", "to": "trip"}], "isa": "SAHH", "first_out": "gt1"},
  {"id": "trip_vib", "at": "brg1_upper", "text": "GT 1 bearing vibration high-high", "when": "vib_hh", "do": [{"machine": "turbine", "to": "trip"}], "isa": "VAHH", "delay": 2, "first_out": "gt1"},
  {"id": "trip_surge", "at": "rotor", "text": "GT 1 compressor surge", "when": "surge_c", "do": [{"machine": "turbine", "to": "trip"}], "isa": "PDAHH", "delay": 0.2, "first_out": "gt1"},
  {"id": "trip_oil_temp", "at": "brg1_housing", "text": "GT 1 lube oil temperature high-high", "when": "oil_t_hh", "do": [{"machine": "turbine", "to": "trip"}], "isa": "TAHH", "delay": 2, "first_out": "gt1"},
  {"id": "trip_breaker", "at": "bench", "text": "Generator 1 breaker opened by protection (GT tripped)", "when": "prot_c", "do": [{"set": {"brk_cmd": 0}}], "first_out": "gt1"}
 ],
 "alarms": [
  {"id": "lp1_low", "at": "brg1_housing", "text": "GT 1 lube oil pressure low (1)", "when": "lp_1_l", "priority": 2, "where": "brg1_housing", "isa": "PAL", "suppress": "lube_sup"},
  {"id": "oil_t_h", "at": "brg1_housing", "text": "GT 1 lube oil temperature high", "when": "oil_t_h", "priority": 2, "where": "bench", "isa": "TAH", "clear": "oil_t_hc"},
  {"id": "gas_low", "at": "fuel_ring", "text": "Fuel gas pressure low (start blocked)", "when": "gas_lo", "priority": 2, "where": "fuel_ring", "isa": "PAL"},
  {"id": "flame1_fail", "at": "liner_02", "text": "GT 1 flame failure (1)", "when": "flame_lost", "priority": 1, "where": "liner_02", "isa": "BAL"},
  {"id": "tc1_h", "at": "exhaust", "text": "GT 1 exhaust temperature high (1)", "when": "tc1_h", "priority": 2, "where": "exhaust", "isa": "TAH"},
  {"id": "tc7_dev", "at": "exhaust", "text": "GT 1 exhaust temperature spread high: thermocouple 7 over 30 K from the mean", "when": "tc7_dev", "priority": 2, "where": "exhaust", "isa": "TDAH"},
