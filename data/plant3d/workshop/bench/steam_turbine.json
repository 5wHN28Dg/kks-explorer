 "ops": [
  {"at": "bench", "do": "start", "title": "Excitation on", "set": {"exc_cmd": 1}, "needs": [["spd95", "Steam turbine below 95 % speed: excitation would overflux the generator"]]},
  {"at": "bench", "do": "stop", "title": "Excitation off", "set": {"exc_cmd": 0}, "needs": [["brk_open", "The generator breaker is closed: open it first"]]},
  {"at": "bench", "do": "close_breaker", "title": "Close the breaker", "set": {"brk_cmd": 1}, "needs": [["in_fsnl", "Steam turbine not at full speed no load"], ["exc_cmd", "Excitation off"], ["ph_ok", "Sync check: phase angle outside ±10°"], ["slip_ok", "Sync check: frequency difference over 0.1 Hz"], ["v_ok", "Sync check: voltage difference over 5 %"]]},
  {"at": "bench", "do": "open_breaker", "title": "Open the breaker", "set": {"brk_cmd": 0}},
  {"at": "pedestal_f", "do": "set", "title": "Speed bias", "input": "bias", "range": [-0.01, 0.01]},
  {"at": "rotor", "do": "roll", "title": "Roll", "machine": "turbine", "needs": [["trips_clear", "A turbine trip is latched: reset it first"], ["lube_ok", "Lube oil pressure low"], ["tg_run", "Turning gear not running"], ["ecc_ok", "Rotor eccentricity over 40 µm: more time on the turning gear"], ["vac_ok", "Condenser pressure over 12 kPa(a)"], ["p_ok", "HP steam pressure below 40 bar"], ["sh_ok", "HP steam superheat below 50 K"], ["match", "Steam not matched to the HP casing (more than 150 K hotter or 50 K colder)"], ["warm_shut", "HP casing warm-up valve 30MAA10AA101 open: close it before rolling"]]},
  {"at": "rotor", "do": "hold", "title": "Hold speed", "machine": "turbine"},
  {"at": "rotor", "do": "continue", "title": "Continue", "machine": "turbine"},
  {"at": "rotor", "do": "stop", "title": "Stop", "machine": "turbine"},
  {"at": "pedestal_f", "do": "reset", "title": "Reset: lube oil", "trip": "trip_lube"},
  {"at": "pedestal_f", "do": "reset", "title": "Reset: overspeed", "trip": "trip_os"},
  {"at": "thrust_upper", "do": "reset", "title": "Reset: axial", "trip": "trip_axial"},
  {"at": "brg_f_upper", "do": "reset", "title": "Reset: vibration", "trip": "trip_vib"},
  {"at": "valve_l", "do": "reset", "title": "Reset: wet steam", "trip": "trip_steam_t"},
  {"at": "bench", "do": "reset", "title": "Reset: breaker", "trip": "trip_breaker"},
  {"at": "valve_l", "do": "set", "input": "p_supply", "range": [40, 130], "title": "Steam pressure"},
  {"at": "valve_r", "do": "set", "input": "t_set", "range": [400, 565], "title": "Steam temperature"}
 ],
 "machines": [
  {"id": "turbine", "at": "rotor", "init": "standstill", "commands": {"roll": {"from": ["standstill"], "to": "roll"}, "hold": {"from": ["accel"], "to": "hold"}, "continue": {"from": ["hold"], "to": "accel"}, "stop": {"from": ["roll", "soak", "accel", "fsnl", "hold"], "to": "coastdown"}}, "states": [{"id": "standstill", "set": {"adm": 0, "speed_sp": 0, "bias": 0}, "watch": false}, {"id": "roll", "set": {"adm": 1, "speed_sp": 0.2667}, "next": [["at_800", "soak"]], "say": "Stop valves open: rolling to 800 rpm"}, {"id": "soak", "next": [["soak_done", "accel"]], "watch": false, "say": "Holding at 800 rpm to warm"}, {"id": "accel", "set": {"speed_sp": 1}, "next": [["at_3000", "fsnl"]], "say": "Accelerating through the critical speeds (1,600–1,900 rpm) to 3,000 rpm"}, {"id": "fsnl", "next": [["brk_cmd", "loaded"]], "watch": false, "say": "Full speed no load: ready to synchronise"}, {"id": "loaded", "next": [["brk_open", "fsnl"]], "watch": false, "say": "On the grid: inlet pressure control, the bypass closes"}, {"id": "hold", "say": "Speed held"}, {"id": "coastdown", "set": {"adm": 0, "speed_sp": 0, "bias": 0}, "next": [["still", "standstill"]], "say": "Stopping: stop valves closed"}, {"id": "trip", "set": {"adm": 0, "speed_sp": 0, "bias": 0}, "next": [["still", "standstill"]], "say": "TRIPPED: stop valves closed"}]}
 ],
 "trips": [
  {"id": "trip_lube", "at": "pedestal_f", "text": "Steam turbine lube oil pressure low-low", "when": "lp_ll", "do": [{"machine": "turbine", "to": "trip"}], "isa": "PALL", "delay": 1, "first_out": "st"},
  {"id": "trip_os", "at": "pedestal_f", "text": "Steam turbine overspeed", "when": "os", "do": [{"machine": "turbine", "to": "trip"}], "isa": "SAHH", "first_out": "st"},
  {"id": "trip_axial", "at": "thrust_upper", "text": "Steam turbine axial displacement high-high", "when": "axial_hh", "do": [{"machine": "turbine", "to": "trip"}], "isa": "ZAHH", "delay": 0.5, "first_out": "st"},
  {"id": "trip_vib", "at": "brg_f_upper", "text": "Steam turbine bearing vibration high-high", "when": "vib_hh", "do": [{"machine": "turbine", "to": "trip"}], "isa": "VAHH", "delay": 2, "first_out": "st"},
  {"id": "trip_steam_t", "at": "valve_l", "text": "HP steam temperature low (wet steam)", "when": "wet_c", "do": [{"machine": "turbine", "to": "trip"}], "isa": "TALL", "delay": 5, "first_out": "st"},
  {"id": "trip_breaker", "at": "bench", "text": "Steam turbine generator breaker opened by protection", "when": "prot_c", "do": [{"set": {"brk_cmd": 0}}], "first_out": "st"}
 ],
