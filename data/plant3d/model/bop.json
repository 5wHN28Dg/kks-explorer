  ["aux_p_sp", {"product": ["aux_run", 12]}],
  ["aux_p", {"ramp": "aux_p_sp", "rate": 0.02, "rate_down": 0.005, "init": 0, "unit": "bar", "kks": "00QHA10CP001"}],
