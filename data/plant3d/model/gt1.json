  ["gt1_st5_h", {"cmp": ["gt1_st5", ">", 120]}],
  ["gt1_st6", {"sum": ["gt1_stator_t", 0.5], "unit": "°C", "kks": "10MKA10CT006"}],
  ["gt1_st6_h", {"cmp": ["gt1_st6", ">", 120]}],
  ["gt1_ws_tgt", {"of": "gt1_exh_t", "table": [[0, 30], [600, 420]]}],
  ["gt1_ws", {"lag": "gt1_ws_tgt", "tau": 300, "tau_down": 3600, "init": 35, "unit": "°C", "kks": "10MBA10"}],
  ["gt1_ws_hot", {"cmp": ["gt1_ws", ">", 150]}],
  ["gt1_tg_nrun", {"not": "gt1_tg_run"}],
  ["gt1_tg_alarm_c", {"and": ["gt1_ws_hot", "gt1_tg_nrun", "gt1_still"]}],
  ["gt1_v_sp", {"product": ["gt1_exc_cmd", "gt1_speed"]}],
  ["gt1_v", {"lag": "gt1_v_sp", "tau": 2, "unit": "pu"}],
  ["gt1_f", {"product": ["gt1_speed", 50], "unit": "Hz"}],
  ["gt1_slip", {"diff": ["gt1_f", "grid_frequency"], "unit": "Hz"}],
  ["gt1_slip_deg", {"product": ["gt1_slip", 360]}],
  ["gt1_phase", {"wrap": "gt1_slip_deg", "period": 360, "init": 140, "unit": "°"}],
  ["gt1_ph", {"of": "gt1_phase", "table": [[0, 0], [180, 180], [180, -180], [360, 0]], "unit": "°"}],
  ["gt1_ph_abs", {"of": "gt1_ph", "table": [[-180, 180], [0, 0], [180, 180]]}],
  ["gt1_ph_ok", {"cmp": ["gt1_ph_abs", "<=", 10]}],
  ["gt1_slip_abs", {"of": "gt1_slip", "table": [[-1, 1], [0, 0], [1, 1]]}],
  ["gt1_slip_ok", {"cmp": ["gt1_slip_abs", "<=", 0.1]}],
  ["gt1_v_dev", {"of": "gt1_v", "table": [[0, 1], [1, 0], [2, 1]]}],
  ["gt1_v_ok", {"cmp": ["gt1_v_dev", "<=", 0.05]}],
  ["gt1_sync_ok", {"and": ["gt1_ph_ok", "gt1_slip_ok", "gt1_v_ok"]}],
  ["gt1_spd95", {"cmp": ["gt1_speed", ">=", 0.95]}],
  ["gt1_brk_open", {"not": "gt1_brk_cmd"}],
  ["gt1_any_trip", {"or": ["gt1_trip_lube_latched", "gt1_trip_flame_latched", "gt1_trip_exh_latched", "gt1_trip_spread_latched", "gt1_trip_os_latched", "gt1_trip_vib_latched", "gt1_trip_surge_latched", "gt1_trip_drum_hh_latched", "gt1_trip_drum_ll_latched"]}],
  ["gt1_trips_clear", {"not": "gt1_any_trip"}],
  ["gen1_prot_c", {"and": ["gt1_any_trip", "gt1_brk_cmd"]}],
  ["gt1_at_base", {"cmp": ["gt1_mw", ">=", 249]}]
 ],
 "ops": [
  {"kks": "10MBV10AP001", "do": "start", "set": {"gt1_lac_cmd": 1}, "needs": [["gt1_lac_ok", "The motor has a fault: it needs repair before a start"]], "where": ["local", "screen"]},
  {"kks": "10MBV10AP001", "do": "stop", "set": {"gt1_lac_cmd": 0}, "where": ["local", "screen"]},
  {"kks": "10MBV10AP002", "do": "start", "set": {"gt1_ldc_cmd": 1}, "needs": [["gt1_ldc_ok", "The motor has a fault: it needs repair before a start"]], "where": ["local", "screen"]},
  {"kks": "10MBV10AP002", "do": "stop", "set": {"gt1_ldc_cmd": 0}, "where": ["local", "screen"]},
  {"kks": "10MKC10", "do": "start", "set": {"gt1_exc_cmd": 1}, "needs": [["gt1_spd95", "GT 1 below 95 % speed: excitation would overflux the generator"]], "where": ["screen"]},
  {"kks": "10MKC10", "do": "stop", "set": {"gt1_exc_cmd": 0}, "needs": [["gt1_brk_open", "The generator breaker is closed: open it first"]], "where": ["screen"]},
  {"kks": "10BAC10", "do": "close_breaker", "set": {"gt1_brk_cmd": 1}, "needs": [["gt1_in_fsnl", "GT 1 not at full speed no load"], ["gt1_exc_cmd", "Excitation off"], ["gt1_ph_ok", "Sync check: phase angle outside ±10°"], ["gt1_slip_ok", "Sync check: frequency difference over 0.1 Hz"], ["gt1_v_ok", "Sync check: voltage difference over 5 %"]], "where": ["screen"]},
  {"kks": "10BAC10", "do": "open_breaker", "set": {"gt1_brk_cmd": 0}, "where": ["screen"]},
  {"kks": "10MBY10CS001", "do": "set", "input": "gt1_bias", "range": [-0.01, 0.01], "where": ["screen"]},
  {"kks": "10MBA10", "do": "start", "machine": "gt1_start", "needs": [["gt1_lube_ok", "Lube oil pressure below 1.8 bar"], ["gt1_tg_run", "Turning gear not running"], ["gt1_gas_ok", "Fuel gas pressure below 25 bar"], ["ccw_ok", "Closed cooling water not in service"], ["gt1_trips_clear", "A GT trip is latched: reset it first"], ["hp_lvl_ok", "HP drum level outside ±150 mm"], ["fw_avail", "No feedwater pump running"]], "where": ["screen"]},
  {"kks": "10MBA10", "do": "stop", "machine": "gt1_start", "where": ["screen"]},
  {"kks": "10MKA10", "do": "set", "input": "gt1_load_sp", "range": [10, 250], "where": ["screen"]},
  {"kks": "10MBK10AE001", "do": "start", "set": {"gt1_tg_cmd": 1}, "needs": [["gt1_lube_ok", "Lube oil pressure below 1.8 bar"]], "where": ["local", "screen"]},
  {"kks": "10MBK10AE001", "do": "stop", "set": {"gt1_tg_cmd": 0}, "where": ["local", "screen"]},
  {"kks": "10MBV10CP001", "do": "reset", "trip": "gt1_trip_lube", "where": ["screen"]},
  {"kks": "10MBM10CB001", "do": "reset", "trip": "gt1_trip_flame", "where": ["screen"]},
  {"kks": "10MBR10CT001", "do": "reset", "trip": "gt1_trip_exh", "where": ["screen"]},
  {"kks": "10MBR10CT002", "do": "reset", "trip": "gt1_trip_spread", "where": ["screen"]},
  {"kks": "10MBY10CS001", "do": "reset", "trip": "gt1_trip_os", "where": ["screen"]},
  {"kks": "10MBD10CY001", "do": "reset", "trip": "gt1_trip_vib", "where": ["screen"]},
  {"kks": "10MBA10", "do": "reset", "trip": "gt1_trip_surge", "where": ["screen"]},
  {"kks": "10HAD30CL001", "do": "reset", "trip": "gt1_trip_drum_hh", "where": ["screen"]},
