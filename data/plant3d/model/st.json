  {"id": "st_start", "kks": "30MAA10", "init": "standstill", "commands": {"roll": {"from": ["standstill"], "to": "roll"}, "hold": {"from": ["accel"], "to": "hold"}, "continue": {"from": ["hold"], "to": "accel"}, "stop": {"from": ["roll", "soak", "accel", "fsnl", "hold"], "to": "coastdown"}}, "states": [{"id": "standstill", "set": {"st_adm": 0, "st_speed_sp": 0, "st_bias": 0}, "watch": false}, {"id": "roll", "set": {"st_adm": 1, "st_speed_sp": 0.2667}, "next": [["st_at_800", "soak"]], "say": "Stop valves open: rolling to 800 rpm"}, {"id": "soak", "next": [["st_soak_done", "accel"]], "watch": false, "say": "Holding at 800 rpm to warm"}, {"id": "accel", "set": {"st_speed_sp": 1}, "next": [["st_at_3000", "fsnl"]], "say": "Accelerating through the critical speeds (1,600–1,900 rpm) to 3,000 rpm"}, {"id": "fsnl", "next": [["st_brk_cmd", "loaded"]], "watch": false, "say": "Full speed no load: ready to synchronise"}, {"id": "loaded", "next": [["st_brk_open", "fsnl"]], "watch": false, "say": "On the grid: inlet pressure control, the bypass closes"}, {"id": "hold", "say": "Speed held"}, {"id": "coastdown", "set": {"st_adm": 0, "st_speed_sp": 0, "st_bias": 0}, "next": [["st_still", "standstill"]], "say": "Stopping: stop valves closed"}, {"id": "trip", "set": {"st_adm": 0, "st_speed_sp": 0, "st_bias": 0}, "next": [["st_still", "standstill"]], "say": "TRIPPED: stop valves closed"}]},
