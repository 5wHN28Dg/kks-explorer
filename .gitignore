# field data and server state: never commit
plant.db
plant.db-wal
plant.db-shm
restored-*.db
photos/
backups/
config.json
root.key
root.key.new
__pycache__/
source/
to-do.md
.venv/
FILE
dist/
build/
# Android build output
android/.gradle/
android/build/
android/*/build/
android/local.properties
android/.kotlin/
android/*/.cxx/
# Android release signing: the keystore and its passwords live outside the repo (https://github.com/5wHN28Dg/kks-explorer/wiki/Releasing);
# these patterns only guard against a copy landing here by mistake
*.jks
*.keystore
keystore.properties
# wrangler (relay/): local state and caches
relay/.wrangler/
relay/node_modules/
# the manager's working copy of the plant data (M5b: drawings are published by sync, never committed)
plant-data/
# private notes about the plant for Claude Code (plant name, reader accuracy per sheet): never commit
CLAUDE.local.md
# the Flatpak build's state, output and bundles (else every later build would count as "with local changes")
.flatpak-builder/
/state/
/build-flatpak/
*.flatpak
# the Flatpak build's commit (apps/gnome/flatpak/build.sh writes it and removes it after)
apps/gnome/flatpak/buildinfo.flags
