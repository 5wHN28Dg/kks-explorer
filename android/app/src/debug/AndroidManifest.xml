<?xml version="1.0" encoding="utf-8"?>
<!-- Debug builds only: lets tests run one background sync now (adb shell am broadcast -a kks.explorer.DEBUG_SYNC -p kks.explorer). -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <receiver android:name=".DebugSyncReceiver" android:exported="true">
            <intent-filter><action android:name="kks.explorer.DEBUG_SYNC" /></intent-filter>
        </receiver>
        <!-- and point the updater at a test release (DebugUpdateReceiver) -->
        <receiver android:name=".DebugUpdateReceiver" android:exported="true">
            <intent-filter><action android:name="kks.explorer.DEBUG_UPDATE" /></intent-filter>
        </receiver>
        <!-- and call the local API (the move rehearsal, decision 0042) -->
        <receiver android:name=".DebugApiReceiver" android:exported="true">
            <intent-filter><action android:name="kks.explorer.DEBUG_API" /></intent-filter>
        </receiver>
    </application>
</manifest>
