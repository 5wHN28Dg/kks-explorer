<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- self-updates (M5b): hand a verified APK from GitHub Releases to Android's installer, which asks the person -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- the bridge (decision 0042): Android's dialog to remove this old app once the new one has taken over -->
    <uses-permission android:name="android.permission.REQUEST_DELETE_PACKAGES" />
    <!-- the hand-over to the new app: only apps signed with our key may call it (both apps declare it) -->
    <permission android:name="kks.explorer.permission.HANDOVER" android:protectionLevel="signature" />
    <!-- Android 11+: to find the camera apps that may write the photo file (MainActivity.openChooser), and the new app -->
    <queries>
        <intent><action android:name="android.media.action.IMAGE_CAPTURE" /></intent>
        <package android:name="kks.explorer.v2" />
    </queries>
    <application
        android:label="KKS Explorer"
        android:icon="@mipmap/ic_launcher"
        android:allowBackup="false"
        android:networkSecurityConfig="@xml/network_security_config"
        android:theme="@android:style/Theme.Material.NoActionBar"
        android:enableOnBackInvokedCallback="true">
        <provider android:name="androidx.core.content.FileProvider" android:authorities="kks.explorer.files"
            android:exported="false" android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/file_paths" />
        </provider>
        <activity android:name=".MainActivity" android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|smallestScreenSize|uiMode">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <provider android:name=".Bridge$Handover" android:authorities="kks.explorer.handover"
            android:exported="true" android:permission="kks.explorer.permission.HANDOVER" />
        <receiver android:name=".AppUpdates$Receiver" android:exported="false">
            <intent-filter><action android:name="kks.explorer.UPDATE_STATUS" /></intent-filter>
        </receiver>
        <!-- the QR scanner (zxing-android-embedded) is landscape-only by default: follow the phone instead -->
        <activity android:name="com.journeyapps.barcodescanner.CaptureActivity"
            android:screenOrientation="fullSensor" tools:replace="screenOrientation" />
    </application>
</manifest>
