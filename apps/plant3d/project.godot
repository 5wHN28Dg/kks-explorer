; Walkdown Plant (decision 0054): the walkable 3D plant. Godot 4.7.2, pinned (tools/plant3d/bench/fetch_godot.sh).
; Built by build.sh; the plant itself is made by the content build (builder/) into built/, never at app start.
config_version=5

[application]

config/name="Walkdown Plant"
config/description="A generic combined-cycle plant to walk through and operate."
run/main_scene="res://app/main.tscn"
config/features=PackedStringArray("4.7")
config/icon="res://icon.svg"

[autoload]

Controls="*res://app/controls.gd"

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=4

[input_devices]

pointing/emulate_touch_from_mouse=false

[physics]

3d/physics_engine="Jolt Physics"
common/physics_ticks_per_second=60

[rendering]

renderer/rendering_method="forward_plus"
renderer/rendering_method.mobile="mobile"
textures/vram_compression/import_etc2_astc=true
rendering_device/fallback_to_opengl3=true

[walkdown_plant]

; The behaviour engine lives in res://sim/ (its own folder, kept by whoever writes the model's evaluator); the app
; hosts it there and reads nothing else of it yet.
sim/path="res://sim/"
built/path="res://built/"
