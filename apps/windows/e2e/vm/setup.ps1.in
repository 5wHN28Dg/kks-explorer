# First logon of a test VM (docs/decisions/0033): OpenSSH Server with the test key, PowerShell as its shell,
# no sleep. Logs to C:\kks-setup.log.
Start-Transcript -Path C:\kks-setup.log -Append
Add-WindowsCapability -Online -Name OpenSSH.Server~~~~0.0.1.0
Set-Service -Name sshd -StartupType Automatic
Start-Service sshd
New-NetFirewallRule -Name kks-sshd -DisplayName "OpenSSH Server (tests)" -Enabled True -Direction Inbound -Protocol TCP -Action Allow -LocalPort 22 -ErrorAction SilentlyContinue
$k = "C:\ProgramData\ssh\administrators_authorized_keys"
Set-Content -Path $k -Value "@SSH_PUBLIC_KEY@" -Encoding ascii
icacls.exe $k /inheritance:r /grant "Administrators:F" /grant "SYSTEM:F"
New-ItemProperty -Path "HKLM:\SOFTWARE\OpenSSH" -Name DefaultShell -Value "C:\Windows\System32\WindowsPowerShell\v1.0\powershell.exe" -PropertyType String -Force
powercfg /change standby-timeout-ac 0
powercfg /change monitor-timeout-ac 0
Set-Content -Path C:\kks-setup-done.txt -Value (Get-Date)
Stop-Transcript
